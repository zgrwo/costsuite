<Window x:Class="BomAddIn.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BOM Suite — 仪表盘"
        Width="900" Height="650"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- KPI 概览 -->
        <GroupBox Grid.Row="0" Header="KPI 概览" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                <!-- 物料总数 -->
                <Border Background="#E3F2FD" CornerRadius="4" Padding="16,8" Margin="0,0,12,0" MinWidth="140">
                    <StackPanel>
                        <TextBlock Text="物料总数" FontSize="12" Foreground="#555"/>
                        <TextBlock Text="{Binding MaterialCount}" FontSize="28" FontWeight="Bold" Foreground="#1976D2"/>
                    </StackPanel>
                </Border>
                <!-- 活跃 BOM -->
                <Border Background="#E8F5E9" CornerRadius="4" Padding="16,8" Margin="0,0,12,0" MinWidth="140">
                    <StackPanel>
                        <TextBlock Text="活跃 BOM 数" FontSize="12" Foreground="#555"/>
                        <TextBlock Text="{Binding ActiveBomCount}" FontSize="28" FontWeight="Bold" Foreground="#388E3C"/>
                    </StackPanel>
                </Border>
                <!-- 预警数 -->
                <Border Background="#FFF3E0" CornerRadius="4" Padding="16,8" Margin="0,0,12,0" MinWidth="140">
                    <StackPanel>
                        <TextBlock Text="预警数" FontSize="12" Foreground="#555"/>
                        <TextBlock Text="{Binding AlertCount}" FontSize="28" FontWeight="Bold" Foreground="#F57C00"/>
                    </StackPanel>
                </Border>
                <!-- 最后同步 -->
                <Border Background="#F3E5F5" CornerRadius="4" Padding="16,8" MinWidth="180">
                    <StackPanel>
                        <TextBlock Text="最后同步" FontSize="12" Foreground="#555"/>
                        <TextBlock Text="{Binding LastSyncText}" FontSize="16" FontWeight="Bold" Foreground="#7B1FA2"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </GroupBox>

        <!-- BOM 展开 -->
        <GroupBox Grid.Row="1" Header="BOM 结构查看" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="物料编码:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" Text="{Binding BomSearchCode, UpdateSourceTrigger=PropertyChanged}"
                         Width="180" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="展开" Command="{Binding ExpandBomCommand}"
                        Width="60" HorizontalAlignment="Left" Margin="8,0,0,0"/>
            </Grid>
        </GroupBox>

        <!-- 左侧: 预警列表 + 右侧: BOM 树 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 预警列表 -->
            <GroupBox Grid.Column="0" Header="预警列表" Margin="0,0,6,0">
                <ListView ItemsSource="{Binding Alerts}" SelectionMode="Single">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="级别" Width="60" DisplayMemberBinding="{Binding Severity}"/>
                            <GridViewColumn Header="信息" Width="200" DisplayMemberBinding="{Binding Message}"/>
                            <GridViewColumn Header="规则" Width="120" DisplayMemberBinding="{Binding TriggeredRule}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>

            <!-- BOM 展开树 -->
            <GroupBox Grid.Column="1" Header="BOM 结构" Margin="6,0,0,0">
                <TreeView ItemsSource="{Binding BomTreeNodes}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayText}" FontFamily="Consolas" FontSize="12"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </GroupBox>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="3" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button Content="刷新" Command="{Binding RefreshCommand}" Width="60" Height="24"
                        Padding="4,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button Content="同步数据" Command="{Binding SyncNowCommand}" Width="70" Height="24"
                        Padding="4,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
