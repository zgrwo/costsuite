<UserControl x:Class="BomAddIn.UI.TaskPane.BomTaskPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320" MinHeight="400"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <!-- Header -->
            <TextBlock Text="BOM Suite" FontSize="16" FontWeight="Bold"
                       Foreground="#0078D4" Margin="0,0,0,10"/>

            <!-- Sync Status Section -->
            <TextBlock Text="🔄 同步状态" Style="{StaticResource SectionHeader}"/>
            <Border Background="#F5F5F5" Padding="8" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="上次同步:" Style="{StaticResource StatusLabel}"/>
                    <TextBlock x:Name="txtLastSync" Text="从未同步" Foreground="#666" FontStyle="Italic"/>
                    <TextBlock Text="同步状态:" Style="{StaticResource StatusLabel}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="txtSyncStatus" Text="就绪" Foreground="Green"/>
                    <Button x:Name="btnSync" Content="立即同步" Click="OnSyncClick"
                            Style="{StaticResource ActionButton}" Width="100"/>
                </StackPanel>
            </Border>

            <!-- Quick Search Section -->
            <TextBlock Text="🔍 快速搜索" Style="{StaticResource SectionHeader}"/>
            <Border Background="#F5F5F5" Padding="8" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="物料编码:" Style="{StaticResource StatusLabel}"/>
                    <TextBox x:Name="txtSearchCode" Height="26" Margin="0,3,0,5"
                             KeyDown="OnSearchKeyDown"/>
                    <Button x:Name="btnSearch" Content="搜索" Click="OnSearchClick"
                            Style="{StaticResource ActionButton}" Width="80"/>
                    <TextBlock x:Name="txtSearchResult" Text=""
                               Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Snapshot Section -->
            <TextBlock Text="📸 快照" Style="{StaticResource SectionHeader}"/>
            <Border Background="#F5F5F5" Padding="8" CornerRadius="4">
                <StackPanel>
                    <Button x:Name="btnSnapshot" Content="创建手动快照" Click="OnSnapshotClick"
                            Style="{StaticResource ActionButton}" Width="120"/>
                    <TextBlock x:Name="txtSnapshotResult" Text=""
                               Margin="0,5,0,0" FontSize="11" Foreground="#666"/>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <TextBlock Text="BOM Suite v1.1"
                       FontSize="10" Foreground="#999"
                       HorizontalAlignment="Center" Margin="0,15,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
