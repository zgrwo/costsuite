<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>BomAddIn.IntegrationTests</AssemblyName>
    <RootNamespace>BomAddIn.IntegrationTests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BomAddIn.Core\BomAddIn.Core.csproj" />
    <ProjectReference Include="..\..\src\BomAddIn.Data\BomAddIn.Data.csproj" />
    <ProjectReference Include="..\..\src\BomAddIn.Infrastructure\BomAddIn.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- DuckDB 原生库: 从 BomAddIn 项目复制到测试输出目录 -->
  <Target Name="CopyDuckDB" AfterTargets="Build">
    <Copy SourceFiles="..\..\src\BomAddIn\duckdb.dll"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('..\..\src\BomAddIn\duckdb.dll')" />
  </Target>
</Project>
